# ====================================================================
# listing-studio 環境変数テンプレート
# ====================================================================
# .env.local にコピーして使用してください（.env.local は git 管理外）。
# cp .env.example .env.local
# ====================================================================

# --- Supabase（無料枠で開始） ----------------------------------------
# Supabase ダッシュボード → プロジェクト設定 → API から取得
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# サーバー側操作（Storage 直アクセス等）に使う場合のみ
# 公開禁止（NEXT_PUBLIC_ 接頭辞をつけないこと）
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Gemini API ------------------------------------------------------
# https://aistudio.google.com/apikey で発行
# 既存キー流用可（社長が共有）
GEMINI_API_KEY=your-gemini-api-key

# --- アプリ設定 ------------------------------------------------------
# 画像リサイズのデフォルト長辺（px）。1024 / 1920 / 0(オリジナル)
NEXT_PUBLIC_DEFAULT_IMAGE_LONG_EDGE=1024

# 開発時の URL（PWA 化したときに使う）
NEXT_PUBLIC_APP_URL=http://localhost:3000
